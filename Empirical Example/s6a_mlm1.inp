TITLE: s6a
DATA: 
   FILE = data1.txt;
VARIABLE:
   NAMES = id time age x1-x3 m1-m3 y1-y6;
   USEVAR = id x1-x3 m1-m3 y1-y6;
   cluster = id;
   
ANALYSIS:
  TYPE=TWOLEVEL;
  ESTIMATOR = BAYES;
  PROCESSORS = 3;
  FBITERATIONS = 20000;
  ALGORITHM=GIBBS(RW);
  POINT=MEAN;

MODEL:
%between%
    tx by x1-x3;
	tm by m1-m3;
	ty by y1-y6;
    [x1-x3@0];
    [m1-m3@0];
    [y1-y6@0];
    x1-x3@0;
    m1-m3@0;
    y1-y6@0;
    tx@0;
	tm on tx (ab);
    [tm];
	ty on tx
		  tm (bb);
    [ty];
%within%
    wx by x1-x3;
	wm by m1-m3;
	wy by y1-y6;
    wm on wx (aw);
    [wm];
    wy on wx
          wm (bw);
    [wy];
MODEL CONSTRAINT:
	new (indb indw);
	indb=ab*bb*sqrt(0.019)/sqrt(0.137);
    indw=aw*bw*sqrt(0.001)/sqrt(0.14);
output:standardized;